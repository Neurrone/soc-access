<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- The .po reader the mod uses at runtime, so the validator checks exactly what the game
       resolves rather than a second copy of the parser. -->
  <ItemGroup>
    <Compile Include="..\..\localization\PoTranslationCatalog.cs" Link="PoTranslationCatalog.cs" />
  </ItemGroup>

</Project>
