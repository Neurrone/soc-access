<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="GamePaths.props" Condition="Exists('GamePaths.props')" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>SongsOfConquest.Access</AssemblyName>
    <RootNamespace>SongsOfConquestAccess</RootNamespace>
    <Description>Accessibility mod for Songs of Conquest</Description>
    <Version>0.6.0</Version>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup>
    <BepInExCoreDir>$(GameDir)\BepInEx\core</BepInExCoreDir>
    <GameManagedDir>$(GameDir)\SongsOfConquest_Data\Managed</GameManagedDir>
    <ScriptOutputDir>$(GameDir)\BepInEx\scripts</ScriptOutputDir>
    <DeployTranslationsDir>$(GameDir)\BepInEx\config\SongsOfConquestAccess\translations</DeployTranslationsDir>
    <DeployDllPath>$(ScriptOutputDir)\$(AssemblyName).dll</DeployDllPath>
    <DeployPdbPath>$(ScriptOutputDir)\$(AssemblyName).pdb</DeployPdbPath>
    <ReleaseTemplatePluginsDir>$(MSBuildProjectDirectory)\..\release-template\BepInEx\plugins</ReleaseTemplatePluginsDir>
    <ReleaseTemplateTranslationsDir>$(MSBuildProjectDirectory)\..\release-template\BepInEx\config\SongsOfConquestAccess\translations</ReleaseTemplateTranslationsDir>
    <ReleaseTemplatePluginDllPath>$(ReleaseTemplatePluginsDir)\$(AssemblyName).dll</ReleaseTemplatePluginDllPath>
    <PrismDllPath>$(MSBuildProjectDirectory)\..\release-template\prism.dll</PrismDllPath>
    <DeployPrismDllPath>$(GameDir)\prism.dll</DeployPrismDllPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="tools\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="translations\*.po">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Zenject">
      <HintPath>$(GameManagedDir)\Zenject.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Zenject-usage">
      <HintPath>$(GameManagedDir)\Zenject-usage.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(GameManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Mathematics">
      <HintPath>$(GameManagedDir)\Unity.Mathematics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(GameManagedDir)\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Addressables">
      <HintPath>$(GameManagedDir)\Unity.Addressables.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UniTask">
      <HintPath>$(GameManagedDir)\UniTask.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DOTween">
      <HintPath>$(GameManagedDir)\DOTween.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="modio.UI">
      <HintPath>$(GameManagedDir)\modio.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="modio.UnityPlugin">
      <HintPath>$(GameManagedDir)\modio.UnityPlugin.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lavapotion.SongsOfConquest.GameLogicLayer.Runtime">
      <HintPath>$(GameManagedDir)\Lavapotion.SongsOfConquest.GameLogicLayer.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lavapotion.SongsOfConquest.ProjectInstaller.Runtime">
      <HintPath>$(GameManagedDir)\Lavapotion.SongsOfConquest.ProjectInstaller.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lavapotion.SongsOfConquest.UILayer.Runtime">
      <HintPath>$(GameManagedDir)\Lavapotion.SongsOfConquest.UILayer.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lavapotion.SongsOfConquest.UtilitiesLayer.Runtime">
      <HintPath>$(GameManagedDir)\Lavapotion.SongsOfConquest.UtilitiesLayer.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lavapotion.Utilities">
      <HintPath>$(GameManagedDir)\Lavapotion.Utilities.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lavapotion.Networking">
      <HintPath>$(GameManagedDir)\Lavapotion.Networking.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lavapotion.Pathfinding">
      <HintPath>$(GameManagedDir)\Lavapotion.Pathfinding.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AutoGeneratedDef">
      <HintPath>$(GameManagedDir)\AutoGeneratedDef.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CommanderUtilsDef">
      <HintPath>$(GameManagedDir)\CommanderUtilsDef.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="DeployToScriptFolder"
          AfterTargets="Build"
          Condition="'$(GameDir)' != '' and '$(DeployToGame)' == 'true'">
    <Message Text="Deploying $(TargetPath) to $(DeployDllPath)" Importance="High" />
    <MakeDir Directories="$(ScriptOutputDir)" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFiles="$(DeployDllPath)"
          SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pdb"
          DestinationFiles="$(DeployPdbPath)"
          SkipUnchangedFiles="false"
          Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
    <Copy SourceFiles="$(PrismDllPath)"
          DestinationFiles="$(DeployPrismDllPath)"
          SkipUnchangedFiles="false"
          Condition="Exists('$(PrismDllPath)')" />
    <ItemGroup>
      <ModTranslationFiles Include="$(MSBuildProjectDirectory)\translations\*.po" />
    </ItemGroup>
    <MakeDir Directories="$(DeployTranslationsDir)"
             Condition="'@(ModTranslationFiles)' != ''" />
    <Copy SourceFiles="@(ModTranslationFiles)"
          DestinationFolder="$(DeployTranslationsDir)"
          SkipUnchangedFiles="false"
          Condition="'@(ModTranslationFiles)' != ''" />
  </Target>

  <Target Name="CopyReleaseDllToTemplatePlugins"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release'">
    <Message Text="Copying release DLL to $(ReleaseTemplatePluginDllPath)" Importance="High" />
    <MakeDir Directories="$(ReleaseTemplatePluginsDir)" />
    <RemoveDir Directories="$(ReleaseTemplatePluginsDir)\translations"
               Condition="Exists('$(ReleaseTemplatePluginsDir)\translations')" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFiles="$(ReleaseTemplatePluginDllPath)"
          SkipUnchangedFiles="false" />
    <ItemGroup>
      <ModTranslationFiles Include="$(MSBuildProjectDirectory)\translations\*.po" />
    </ItemGroup>
    <MakeDir Directories="$(ReleaseTemplateTranslationsDir)"
             Condition="'@(ModTranslationFiles)' != ''" />
    <Copy SourceFiles="@(ModTranslationFiles)"
          DestinationFolder="$(ReleaseTemplateTranslationsDir)"
          SkipUnchangedFiles="false"
          Condition="'@(ModTranslationFiles)' != ''" />
  </Target>

</Project>
